meta {
  name: X-02 · Juan solo ve sus propias reservas
  type: http
  seq: 2
}

get {
  url: {{host}}/reservations
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{tokenJuan}}
}

tests {
  test("X-02 responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("X-02 · todas son de Juan", function () {
    const ajenas = (res.body.data || []).filter((r) => r.user_id !== bru.getVar("idJuan"));
    expect(ajenas).to.have.length(0);
  });
}

