meta {
  name: CL-05 · Salida el mismo día de la entrada
  type: http
  seq: 1
}

post {
  url: {{host}}/reservations
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{tokenAna}}
}

body:json {
  {
    "room_id": {{room1Id}},
    "check_in": "{{hoyMas10}}",
    "check_out": "{{hoyMas10}}"
  }
}

tests {
  test("CL-05 responde 422", function () {
    expect(res.getStatus()).to.equal(422);
  });

  test("CL-05 · error en check_out", function () {
    expect(res.body.errors).to.have.property("check_out");
  });

  test("CL-05 · el error viene en JSON", function () {
    expect(res.getHeader("content-type")).to.include("application/json");
  });
}

docs {
  Técnica: valor límite
  Esperado: 422 · error en check_out
}

