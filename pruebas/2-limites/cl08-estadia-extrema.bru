meta {
  name: CL-08 · Estadía extrema (precio fuera de rango)
  type: http
  seq: 4
}

post {
  url: {{host}}/reservations
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{tokenAna}}
}

body:json {
  {
    "room_id": {{room2Id}},
    "check_in": "{{hoyMas10}}",
    "check_out": "2100-01-01"
  }
}

tests {
  test("CL-08 responde 422", function () {
    expect(res.getStatus()).to.equal(422);
  });

  test("CL-08 · nunca 500", function () {
    expect(res.getStatus()).to.be.below(500);
  });

  test("CL-08 · error en check_out", function () {
    expect(res.body.errors).to.have.property("check_out");
  });

  test("CL-08 · el error viene en JSON", function () {
    expect(res.getHeader("content-type")).to.include("application/json");
  });
}

docs {
  Técnica: valor límite
  Esperado: 422 · error en check_out; nunca 500 (total_price es decimal(8,2), máximo 999999.99)
}

