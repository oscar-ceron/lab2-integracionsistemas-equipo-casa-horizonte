meta {
  name: CL-02 · Contraseña incorrecta
  type: http
  seq: 1
}

post {
  url: {{host}}/login
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "email": "{{emailAna}}",
    "password": "no-es-la-contrasena-de-ana",
    "device_name": "bruno-cl02"
  }
}

tests {
  test("CL-02 responde 422", function () {
    expect(res.getStatus()).to.equal(422);
  });

  test("CL-02 · error en email", function () {
    expect(res.body.errors).to.have.property("email");
  });

  test("CL-02 · el error viene en JSON", function () {
    expect(res.getHeader("content-type")).to.include("application/json");
  });
}

docs {
  Técnica: caso negativo
  Esperado: 422 · error en email (credenciales incorrectas)
}

